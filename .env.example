# Configuration du .env
# Copie ce fichier en .env et remplis les valeurs

# 🤖 Token Hugging Face pour l'IA (GRATUIT)
# 1. Va sur https://huggingface.co/join
# 2. Crée un compte (gratuit)
# 3. Va dans Settings → Access Tokens
# 4. Crée un nouveau token "read"
# 5. Copie le token ici
HF_TOKEN=hf_your_token_here

# 📱 Numéro du propriétaire (optionnel)
OWNER_NUMBER=+223834667782

# 🎯 Prefix des commandes (par défaut: !)
BOT_PREFIX=!

# 🐛 Mode debug
DEBUG=true

# 🌐 Port pour webhooks (optionnel)
PORT=3000
